{
  "name": "myllm-report",
  "version": "1.0.0",
  "description": "LLM 대화 export JSON을 분석해 월간 리포트를 생성하는 로컬 CLI 도구",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "analyze": "ts-node src/index.ts run --open",
    "analyze:chatgpt": "ts-node src/index.ts run --file data/chatgpt_export.json --platform chatgpt --open"
  },
  "keywords": [
    "llm",
    "report",
    "claude",
    "chatgpt",
    "ollama"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^9.4.3",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
